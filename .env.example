# Copiar a .env y elegir una contraseña local antes de iniciar PostgreSQL.
# Nunca versionar .env ni usar estas credenciales para producción.
APP_PORT=8000
# Un único proyecto Compose con app + PostgreSQL al ejecutar `docker compose up`.
# Quitar esta variable permite iniciar solo el dashboard histórico.
COMPOSE_PROFILES=persistencia
POSTGRES_DB=ia_logistica
POSTGRES_USER=ia_app
POSTGRES_PASSWORD=

# Conexión desde Python ejecutado en el host. Compose usa db:5432 internamente.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONNECT_TIMEOUT=3

# Opcional: sustituye host/puerto/usuario/contraseña/BD anteriores para Python.
# Debe usar postgresql+psycopg:// y escapar los caracteres de usuario/contraseña.
# No modifica la inicialización del servidor Docker.
# DATABASE_URL=postgresql+psycopg://usuario:clave@127.0.0.1:5433/ia_logistica

# Solo host; Docker usa el volumen visual_data en /var/lib/ia/visual.
# VISUAL_STORAGE_ROOT=/ruta/privada/almacen-visual
